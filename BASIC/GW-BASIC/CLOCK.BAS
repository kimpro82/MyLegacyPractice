10  ' ************************************************************
20  ' PROJECT: ANALOG CLOCK (FINAL REFINED VER)
30  ' AUTHOR: KIMPRO82 / GEMINI 3 FLASH
40  ' DATE: 2026-05-04
50  ' ************************************************************
80  GOSUB 1000 : ' DEFINE CONSTANTS
90  GOSUB 2000 : ' SETUP GRAPHICS
100 GOSUB 3000 : ' DRAW CLOCK FACE & METADATA
110 '
120 ' --- MAIN LOOP ---
130 GOSUB 4000 : ' GET SYSTEM TIME
135 K$ = INKEY$ : IF K$ <> "" THEN GOSUB 8000 : ' GRACEFUL EXIT
140 IF CURSEC = OLDSEC THEN GOTO 130
160 GOSUB 5000 : ' ERASE OLD HANDS
170 GOSUB 6000 : ' CALCULATE NEW POSITIONS
180 GOSUB 7000 : ' DRAW NEW HANDS
200 OLDSEC = CURSEC : OLDMIN = CURMIN : OLDHR = CURHR
210 GOTO 130
220 '
1000 ' --- SUB: CONSTANTS ---
1010 PI = 3.14159
1020 CX% = 160 : CY% = 100 : AR = 0.8
1030 R1% = 70 : L1% = 65 : L2% = 55 : L3% = 40
1040 RETURN
2000 ' --- SUB: SETUP GRAPHICS ---
2010 SCREEN 0 : WIDTH 80 : CLS
2020 SCREEN 1 : COLOR 0, 1 : CLS
2030 RETURN
3000 ' --- SUB: DRAW FACE & METADATA ---
3010 ' DRAW HEADER METADATA
3020 LOCATE  3,  5 : PRINT "GW-BASIC ANALOG CLOCK BY KIMPRO82"
3030 LOCATE  5, 26 : PRINT "(2026-05-04)"
3040 LOCATE 24, 11 : PRINT "PRESS ANY KEY TO EXIT"
3050 ' DRAW FACE
3060 CIRCLE (CX%, CY%), R1%, 1
3070 FOR I% = 1 TO 12
3080   A = (I% * 30 - 90) * (PI / 180)
3090   TX% = CX% + (R1% - 12) * COS(A)
3100   TY% = CY% + (R1% - 12) * SIN(A) * AR
3110   R% = INT(TY% / 8) + 1 : C% = INT(TX% / 8) + 1
3120   ' FINE-TUNE ALIGNMENT FOR DOUBLE DIGITS
3130   IF I% >= 10 THEN C% = C% - 1
3140   LOCATE R%, C% : PRINT I%;
3150 NEXT I%
3160 RETURN
4000 ' --- SUB: TIME ---
4010 T$ = TIME$
4020 CURHR = VAL(LEFT$(T$, 2)) : CURMIN = VAL(MID$(T$, 4, 2)) : CURSEC = VAL(RIGHT$(T$, 2))
4030 RETURN
5000 ' --- SUB: ERASE ---
5010 IF OLDSEC = 0 THEN RETURN
5020 LINE (CX%, CY%)-(INT(OXS), INT(OYS)), 0
5030 LINE (CX%, CY%)-(INT(OXM), INT(OYM)), 0
5040 LINE (CX%, CY%)-(INT(OXH), INT(OYH)), 0
5050 RETURN
6000 ' --- SUB: CALC ---
6110 SA = (CURSEC * 6 - 90) * (PI / 180)
6120 OXS = CX% + L1% * COS(SA) : OYS = CY% + L1% * SIN(SA) * AR
6210 MA = (CURMIN * 6 - 90) * (PI / 180)
6220 OXM = CX% + L2% * COS(MA) : OYM = CY% + L2% * SIN(MA) * AR
6310 HA = (CURHR * 30 + CURMIN * 0.5 - 90) * (PI / 180)
6320 OXH = CX% + L3% * COS(HA) : OYH = CY% + L3% * SIN(HA) * AR
6330 RETURN
7000 ' --- SUB: DRAW ---
7010 LINE (CX%, CY%)-(INT(OXS), INT(OYS)), 1
7020 LINE (CX%, CY%)-(INT(OXM), INT(OYM)), 1
7030 LINE (CX%, CY%)-(INT(OXH), INT(OYH)), 1
7040 RETURN
8000 ' --- SUB: GRACEFUL EXIT ---
8010 SCREEN 0 : WIDTH 80 : CLS
8020 END
