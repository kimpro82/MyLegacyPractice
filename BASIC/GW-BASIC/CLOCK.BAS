10  ' ************************************************************
20  ' PROJECT: ANALOG CLOCK (FINAL COMPATIBILITY VER)
30  ' AUTHOR : KIMPRO82 POWERED BY GEMINI 3 FLASH
40  ' DATE   : 2026.05.03
50  ' ************************************************************
70  ' --- INITIALIZATION ---
80  GOSUB 1000 : ' CONSTANTS
90  GOSUB 2000 : ' RESET & SETUP SCREEN
100 GOSUB 3000 : ' DRAW CLOCK FACE
110 '
120 ' --- MAIN LOOP ---
130 GOSUB 4000 : ' GET TIME
140 IF CURSEC = OLDSEC THEN GOTO 130
160 GOSUB 5000 : ' ERASE OLD HANDS
170 GOSUB 6000 : ' CALC POSITIONS
180 GOSUB 7000 : ' DRAW NEW HANDS
190 OLDSEC = CURSEC : OLDMIN = CURMIN : OLDHR = CURHR
200 GOTO 130
1000 ' --- SUB: CONSTANTS ---
1010 PI = 3.14159
1020 CX = 160 : CY = 100 : AR = 0.8
1030 R1 = 80 : L1 = 70 : L2 = 60 : L3 = 40
1040 RETURN
2000 ' --- SUB: SCREEN RESET ---
2010 SCREEN 0 : WIDTH 80 : CLS : ' RESET TO TEXT MODE FIRST
2020 SCREEN 1 : COLOR 0, 1 : CLS : ' THEN SWITCH TO GRAPHICS
2030 RETURN
3000 ' --- SUB: CLOCK FACE ---
3010 CIRCLE (CX, CY), R1, 1
3020 FOR I = 1 TO 12
3030   A = (I * 30 - 90) * (PI / 180)
3040   TX = CX + (R1 - 15) * COS(A)
3050   TY = CY + (R1 - 15) * SIN(A) * AR
3060   ' Make sure Row and Column are clean integers
3070   TR% = INT(TY / 8) + 1 : TC% = INT(TX / 8) + 1
3075   ' Boundary check
3076   IF TR% < 1 THEN TR% = 1 ELSE IF TR% > 25 THEN TR% = 25
3077   IF TC% < 1 THEN TC% = 1 ELSE IF TC% > 40 THEN TC% = 40
3080   LOCATE TR%, TC%
3085   PRINT I; : ' Simple numeric print to avoid STR$ mismatch
3090 NEXT I
3100 RETURN
4000 ' --- SUB: TIME ---
4010 T$ = TIME$
4020 CURHR = VAL(LEFT$(T$, 2)) : CURMIN = VAL(MID$(T$, 4, 2)) : CURSEC = VAL(RIGHT$(T$, 2))
4030 RETURN
5000 ' --- SUB: ERASE ---
5010 IF OLDSEC = 0 AND OLDMIN = 0 AND OLDHR = 0 THEN RETURN
5020 LINE (CX, CY)-(INT(OXS), INT(OYS)), 0
5030 LINE (CX, CY)-(INT(OXM), INT(OYM)), 0
5040 LINE (CX, CY)-(INT(OXH), INT(OYH)), 0
5050 RETURN
6000 ' --- SUB: CALC ---
6110 SA = (CURSEC * 6 - 90) * (PI / 180)
6120 OXS = CX + L1 * COS(SA) : OYS = CY + L1 * SIN(SA) * AR
6210 MA = (CURMIN * 6 - 90) * (PI / 180)
6220 OXM = CX + L2 * COS(MA) : OYM = CY + L2 * SIN(MA) * AR
6310 HA = (CURHR * 30 + CURMIN * 0.5 - 90) * (PI / 180)
6320 OXH = CX + L3 * COS(HA) : OYH = CY + L3 * SIN(HA) * AR
6330 RETURN
7000 ' --- SUB: DRAW ---
7010 LINE (CX, CY)-(INT(OXS), INT(OYS)), 1
7020 LINE (CX, CY)-(INT(OXM), INT(OYM)), 1
7030 LINE (CX, CY)-(INT(OXH), INT(OYH)), 1
7040 RETURN
