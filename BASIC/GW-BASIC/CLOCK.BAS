10  ' ************************************************************
20  ' PROJECT: ANALOG CLOCK
30  ' AUTHOR: KIMPRO82          / GEMINI 3 FLASH
40  ' VERSION : 0.5             / DATE: 2026-05-05
50  ' ************************************************************
60  '
100 GOSUB 1000 : ' DEFINE CONSTANTS
110 GOSUB 2000 : ' SETUP GRAPHICS
120 GOSUB 3000 : ' DRAW CLOCK FACE & METADATA
130 ' 
200 ' --- MAIN LOOP ---
210 GOSUB 4000 : ' GET SYSTEM TIME
220 K$ = INKEY$ : IF K$ <> "" THEN GOSUB 8000 : ' GRACEFUL EXIT
230 IF CURSEC = OLDSEC THEN GOTO 210
240 '
250 GOSUB 5000 : ' ERASE OLD HANDS (BACKGROUND COLOR)
260 '
270 ' UI REFRESH STRATEGY: RE-DRAW FACE ONLY AT THE START OF EACH MINUTE (SEC=2)
280 IF CURSEC = 2 THEN GOSUB 3050
290 '
300 GOSUB 6000 : ' CALCULATE NEW POSITIONS
310 GOSUB 7000 : ' DRAW NEW HANDS
320 '
330 OLDSEC = CURSEC : OLDMIN = CURMIN : OLDHR = CURHR
340 GOTO 210
350 '
1000 ' --- SUB: CONSTANTS ---
1010 PI = 3.14159
1020 CX% = 160 : CY% = 100 : AR = 0.8
1030 R1% = 70 : L1% = 65 : L2% = 55 : L3% = 40
1040 ' INITIALIZE OLD COORDINATES TO PREVENT FIRST-SECOND GHOSTING
1050 OXS=CX% : OYS=CY% : OXM=CX% : OYM=CY% : OXH=CX% : OYH=CY%
1060 RETURN
1070 '
2000 ' --- SUB: SETUP GRAPHICS ---
2010 SCREEN 0 : WIDTH 80 : CLS
2020 SCREEN 1 : COLOR 0, 1 : CLS
2030 RETURN
2040 '
3000 ' --- SUB: DRAW FULL FACE & METADATA ---
3010 LOCATE 3, 5 : PRINT "GW-BASIC ANALOG CLOCK BY KIMPRO82"
3020 LOCATE 5, 26 : PRINT "(2026-05-05)"
3030 LOCATE 24, 11 : PRINT "PRESS ANY KEY TO EXIT"
3040 '
3050 ' --- SUB-ROUTINE: DRAW FACE ONLY ---
3060 FOR I% = 1 TO 12
3070   A = (I% * 30 - 90) * (PI / 180)
3080   TX% = CX% + (R1% - 12) * COS(A)
3090   TY% = CY% + (R1% - 12) * SIN(A) * AR
3100   R% = INT(TY% / 8) + 1 : C% = INT(TX% / 8)
3110   IF I% = 12 THEN C% = C% - 1
3120   LOCATE R%, C% : PRINT I%;
3130 NEXT I%
3140 CIRCLE (CX%, CY%), R1%, 1
3150 RETURN
3160 '
4000 ' --- SUB: TIME ---
4010 T$ = TIME$
4020 CURHR = VAL(LEFT$(T$, 2)) : CURMIN = VAL(MID$(T$, 4, 2)) : CURSEC = VAL(RIGHT$(T$, 2))
4030 RETURN
4040 '
5000 ' --- SUB: ERASE (FORCE ERASE) ---
5010 LINE (CX%, CY%)-(INT(OXS), INT(OYS)), 0
5020 LINE (CX%, CY%)-(INT(OXM), INT(OYM)), 0
5030 LINE (CX%, CY%)-(INT(OXH), INT(OYH)), 0
5040 RETURN
5050 '
6000 ' --- SUB: CALC ---
6010 SA = (CURSEC * 6 - 90) * (PI / 180)
6020 OXS = CX% + L1% * COS(SA) : OYS = CY% + L1% * SIN(SA) * AR
6030 MA = (CURMIN * 6 - 90) * (PI / 180)
6040 OXM = CX% + L2% * COS(MA) : OYM = CY% + L2% * SIN(MA) * AR
6050 HA = (CURHR * 30 + CURMIN * 0.5 - 90) * (PI / 180)
6060 OXH = CX% + L3% * COS(HA) : OYH = CY% + L3% * SIN(HA) * AR
6070 RETURN
6080 '
7000 ' --- SUB: DRAW ---
7010 LINE (CX%, CY%)-(INT(OXS), INT(OYS)), 1
7020 LINE (CX%, CY%)-(INT(OXM), INT(OYM)), 1
7030 LINE (CX%, CY%)-(INT(OXH), INT(OYH)), 1
7040 RETURN
7050 '
8000 ' --- SUB: GRACEFUL EXIT ---
8010 SCREEN 0 : WIDTH 80 : CLS
8020 END
